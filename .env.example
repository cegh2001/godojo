# .env.example — ejemplo de variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# NO commitear el archivo `.env` con credenciales reales.

# Server
PORT=8080
LOG_LEVEL=debug
GIN_MODE=debug

# Database (ejemplo URI, reemplazá por tu conexión)
DATABASE_URL=postgres://dbuser:dbpass@localhost:5432/mi_proyecto_db

# URLs
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# AI / Sensei Gemma 4
GEMINI_API_KEY=your_gemini_api_key
GODOJO_SENSEI_FAST_MODEL=gemma-4-26b-a4b-it
GODOJO_SENSEI_HEAVY_MODEL=gemma-4-31b-it
# Override opcional de la ruta heavy/tool-enabled.
# GODOJO_SENSEI_MODEL=gemma-4-31b-it
# Timeouts opcionales en segundos para respuestas lentas.
# GODOJO_SENSEI_TIMEOUT_SECONDS=30
# GODOJO_SENSEI_TOOL_TIMEOUT_SECONDS=60

# OAuth / Integraciones (usar valores reales en .env)
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret

# Feature flags / otros
ENABLE_DEBUG=true
